# ── Root ──────────────────────────────────────────────────────────────────
.DS_Store
*.pem

# Original camera files (RAW/full-resolution originals).
# Large and non-essential to the build — keep a separate backup of this folder.
assets/raw/

# Auto-generated by Next.js on dev start (next.config: agentRules)
/AGENTS.md
/CLAUDE.md
/apps/web/AGENTS.md
/apps/web/CLAUDE.md

# ── apps/web (Next.js) ────────────────────────────────────────────────────
/apps/web/node_modules
/apps/web/.next/
/apps/web/out/
/apps/web/build
/apps/web/.vercel
/apps/web/*.tsbuildinfo
/apps/web/next-env.d.ts
/apps/web/.env*

# ── apps/api (Laravel) ────────────────────────────────────────────────────
/apps/api/vendor/
/apps/api/node_modules/
/apps/api/public/build/
/apps/api/public/hot
/apps/api/public/storage
/apps/api/storage/*.key
/apps/api/storage/pail
/apps/api/storage/framework/cache/data/*
/apps/api/storage/framework/sessions/*
/apps/api/storage/framework/views/*
/apps/api/storage/logs/*
/apps/api/bootstrap/cache/*.php
/apps/api/.env
/apps/api/.env.backup
/apps/api/.env.production
/apps/api/.phpunit.result.cache
/apps/api/database/*.sqlite
/apps/api/database/*.sqlite-journal
/apps/api/auth.json

# Logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
